{
  "cli": {
    "version": ">= 3.0.0",
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "24.21.0",
      "android": {
        "env": {
          "EXPO_PUBLIC_API_BASE_URL": "https://controlpick.duckdns.org/api/v1"
        }
      }
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "android": {
        "image": "latest",
        "buildType": "apk",
        "env": {
          "EXPO_PUBLIC_API_BASE_URL": "https://controlpick.duckdns.org/api/v1"
        }
      },
      "autoIncrement": true
    }
  }
}
