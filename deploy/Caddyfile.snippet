# Añadir al Caddyfile EXISTENTE de checkcoast (mismo contenedor caddy,
# un site más). Sustituir el dominio por el que uses en DuckDNS.
#
# Requisito: controlpick-backend debe estar en la red checkcoast_default
# (ya lo hace docker-compose.prod.yml) — caddy lo resuelve por nombre.
#
# Tras editar el Caddyfile:
#   docker exec checkcoast-caddy caddy reload --config /etc/caddy/Caddyfile

controlpick.duckdns.org {
	reverse_proxy controlpick-backend:8000
}
