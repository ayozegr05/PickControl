# Añadir al Caddyfile EXISTENTE de checkcoast (mismo contenedor caddy,
# un site más). Sustituir el dominio por el que uses en DuckDNS.
#
# Requisito: el contenedor caddy debe resolver el host —
#   extra_hosts: ["host.docker.internal:host-gateway"]
# en su docker-compose (si ya lo tiene, nada que tocar).

controlpick.duckdns.org {
	reverse_proxy host.docker.internal:8000
}
