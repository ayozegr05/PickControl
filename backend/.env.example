# ============================
# Servidor
# ============================
NODE_ENV=development
SERVER_URL=http://localhost:3000
# Orígenes permitidos para CORS. En dev "*"; en prod, lista separada por comas.
CORS_ORIGINS=*

# ============================
# Base de datos (PostgreSQL)
# ============================
# Cadena de conexión completa (usada por SQLAlchemy/SQLModel + asyncpg)
DATABASE_URL=postgresql+asyncpg://usuario:password@localhost:5432/tipster_auditor
POSTGRES_USER=usuario
POSTGRES_PASSWORD=changeme
POSTGRES_DB=tipster_auditor
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ============================
# Autenticación
# ============================
JWT_SECRET=changeme_generate_a_strong_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

# ============================
# Telegram (cliente de usuario vía Telethon, ver app/services/telegram/)
# ============================
# Obtener API_ID/API_HASH en https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Número de teléfono de la cuenta que se usará para leer el canal
# (formato internacional, ej. +34600000000). Necesario solo la primera
# vez, para el login interactivo que genera el archivo de sesión.
TELEGRAM_PHONE=
TELEGRAM_SESSION_NAME=controlpick_telegram
# Canal objetivo a escuchar: username sin "@" (ej. mi_canal) o id
# numérico con prefijo -100 (ej. -1001125596067). Si se deja vacío, el
# listener de Telegram no se inicia.
TELEGRAM_TARGET_CHANNEL=

# ============================
# Verificación automática de resultados (opcional)
# ============================
# football-data.org: gratis, cubre ligas top (La Liga, Champions,
# Premier, Serie A, Bundesliga, Ligue 1...). Regístrate en
# https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=
# API-Football: más cobertura (ligas menores), límite más bajo en el
# plan gratuito (100 peticiones/día). Se usa como fallback cuando
# football-data.org no encuentra el partido. Regístrate directamente
# (más simple) en https://dashboard.api-football.com/register y copia
# tu api-key desde "My Access" en el dashboard.
API_FOOTBALL_KEY=
API_FOOTBALL_HOST=v3.football.api-sports.io
# Tenis vía TheSportsDB: gratis sin registro. La key pública "3" es la
# compartida de test (suficiente para unas pocas llamadas al día gracias
# a la caché); con Patreon de $2 en thesportsdb.com dan una key propia.
# Cobertura: ATP/WTA Tour y Grand Slams (sin Challenger/ITF).
API_TENNIS_KEY=3
# Fallback de tenis para Challenger/ITF: "Tennis API - ATP WTA ITF" en
# RapidAPI. Crea cuenta gratis en rapidapi.com, suscríbete al plan
# gratuito de esa API y pega tu X-RapidAPI-Key. Solo consume cuota
# cuando TheSportsDB no encuentra el partido.
RAPIDAPI_TENNIS_KEY=
RAPIDAPI_TENNIS_HOST=tennis-api-atp-wta-itf.p.rapidapi.com
# Tercer nivel de tenis: "TennisApi" (tennisapi1) en RapidAPI, datos de
# Sofascore (ATP/WTA/Challenger/ITF/Copas). Reutiliza RAPIDAPI_TENNIS_KEY
# (la key es por cuenta); su cuota es independiente (~50 req/día) y solo
# se consume si los proveedores anteriores no encuentran el partido.
RAPIDAPI_TENNISAPI1_HOST=tennisapi1.p.rapidapi.com
# Cada cuántas horas se revisan picks pendientes de verificar (en segundo
# plano, mientras el backend está arriba). Si ninguna de las dos API keys
# de arriba está configurada, esta tarea no se ejecuta.
RESULTS_VERIFICATION_INTERVAL_HOURS=3
# Cada cuántas horas corre el rescate (OCR pendiente + reproceso de raws).
RESCUE_INTERVAL_HOURS=6
# Días máximos que un raw puede estar pendiente de rescate;
# pasado ese plazo se da por imposible (la fila queda en BD).
RESCUE_MAX_AGE_DAYS=30
# Cada cuántas horas corre el backfill de cuotas históricas (OddsPapi).
ODDS_BACKFILL_INTERVAL_HOURS=24
