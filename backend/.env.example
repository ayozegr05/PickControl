# ============================
# Servidor
# ============================
NODE_ENV=development
SERVER_URL=http://localhost:3000
# Orígenes permitidos para CORS. En dev "*"; en prod, lista separada por comas.
CORS_ORIGINS=*

# ============================
# Base de datos (PostgreSQL)
# ============================
# Cadena de conexión completa (usada por SQLAlchemy/SQLModel + asyncpg)
DATABASE_URL=postgresql+asyncpg://usuario:password@localhost:5432/tipster_auditor
POSTGRES_USER=usuario
POSTGRES_PASSWORD=changeme
POSTGRES_DB=tipster_auditor
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ============================
# Autenticación
# ============================
JWT_SECRET=changeme_generate_a_strong_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

# ============================
# Telegram (cliente de usuario vía Telethon, ver app/services/telegram/)
# ============================
# Obtener API_ID/API_HASH en https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Número de teléfono de la cuenta que se usará para leer el canal
# (formato internacional, ej. +34600000000). Necesario solo la primera
# vez, para el login interactivo que genera el archivo de sesión.
TELEGRAM_PHONE=
TELEGRAM_SESSION_NAME=controlpick_telegram
# Canal objetivo a escuchar: username sin "@" (ej. mi_canal) o id
# numérico con prefijo -100 (ej. -1001125596067). Si se deja vacío, el
# listener de Telegram no se inicia.
TELEGRAM_TARGET_CHANNEL=
