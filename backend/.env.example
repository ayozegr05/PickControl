# ============================
# Servidor
# ============================
NODE_ENV=development
SERVER_URL=http://localhost:3000

# ============================
# Base de datos (PostgreSQL)
# ============================
# Cadena de conexión completa (usada por SQLAlchemy/SQLModel + asyncpg)
DATABASE_URL=postgresql+asyncpg://usuario:password@localhost:5432/tipster_auditor
POSTGRES_USER=usuario
POSTGRES_PASSWORD=changeme
POSTGRES_DB=tipster_auditor
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ============================
# Autenticación
# ============================
JWT_SECRET=changeme_generate_a_strong_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

# ============================
# Telegram (bot + scraping histórico)
# ============================
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT2_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# ============================
# Firebase (legacy, revisar si sigue en uso)
# ============================
GOOGLE_APPLICATION_CREDENTIALS=
