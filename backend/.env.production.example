# ============================
# Entorno de producción
# ============================
# Copia este fichero a .env.production y rellena los secretos reales.
# NUNCA subas .env.production al repositorio.
# Arranca el backend con:
#     ENV_FILE=.env.production uvicorn app.main:app --host 0.0.0.0 --port 8000
NODE_ENV=production
SERVER_URL=https://api.tudominio.com
# CORS restringido a los dominios reales del frontend.
CORS_ORIGINS=https://app.tudominio.com

# ============================
# Base de datos (PostgreSQL)
# ============================
DATABASE_URL=postgresql+asyncpg://user:strong_password@prod-db:5432/controlpick
POSTGRES_USER=user
POSTGRES_PASSWORD=strong_password
POSTGRES_DB=controlpick
POSTGRES_HOST=prod-db
POSTGRES_PORT=5432

# ============================
# Autenticación
# ============================
JWT_SECRET=genera_un_secreto_largo_y_aleatorio_aqui
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

# ============================
# Telegram
# ============================
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_SESSION_NAME=controlpick_telegram
TELEGRAM_TARGET_CHANNEL=

# ============================
# Verificación automática de resultados (opcional)
# ============================
FOOTBALL_DATA_API_KEY=
API_FOOTBALL_KEY=
API_FOOTBALL_HOST=api-football-v1.p.rapidapi.com
RESULTS_VERIFICATION_INTERVAL_HOURS=3
