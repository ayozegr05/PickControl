# ============================
# Entorno de desarrollo local
# ============================
# Copia este fichero a .env.development y rellena los secretos reales.
# Arranca el backend con:
#     ENV_FILE=.env.development uvicorn app.main:app --reload
NODE_ENV=development
SERVER_URL=http://localhost:8000

# ============================
# Base de datos (PostgreSQL)
# ============================
DATABASE_URL=postgresql+asyncpg://usuario:password@localhost:5432/controlpick
POSTGRES_USER=usuario
POSTGRES_PASSWORD=password
POSTGRES_DB=controlpick
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ============================
# Autenticación
# ============================
JWT_SECRET=dev-secret-cambiar-en-produccion
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

# ============================
# Telegram (opcional en dev)
# ============================
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_SESSION_NAME=controlpick_telegram_dev
TELEGRAM_TARGET_CHANNEL=
